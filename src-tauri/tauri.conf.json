{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheets",
  "version": "0.5.0",
  "identifier": "com.internal.sheets",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheets",
        "width": 1400,
        "height": 880,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lightweight, reliable spreadsheets and documents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "xlsx",
          "xlsm"
        ],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV File",
        "description": "Comma separated values",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "docx",
          "docm",
          "dotx",
          "dotm"
        ],
        "name": "Word Document",
        "description": "Word Document",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      }
    ],
    "longDescription": "Sheets and Docs: a fast, lightweight office suite. Sheets opens and saves Excel .xlsx workbooks; Docs opens and saves Word .docx documents. Both keep your files faithful, with AutoRecover and version history.",
    "copyright": "Copyright © 2026 Dipendra Bhardwaj",
    "category": "Productivity",
    "publisher": "Dipendra Bhardwaj",
    "homepage": "https://github.com/Dipendra-creator/sheets-desktop",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/docs-shortcut.wxs"
        ],
        "componentRefs": [
          "DocsStartMenuShortcut"
        ]
      }
    },
    "resources": {
      "icons/docs/docs.ico": "docs.ico"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/sheets-docs.desktop": "linux/sheets-docs.desktop",
          "/usr/share/icons/hicolor/256x256/apps/sheets-docs.png": "icons/docs/docs-256.png",
          "/usr/share/icons/hicolor/128x128/apps/sheets-docs.png": "icons/docs/docs-128.png",
          "/usr/share/icons/hicolor/64x64/apps/sheets-docs.png": "icons/docs/docs-64.png"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/applications/sheets-docs.desktop": "linux/sheets-docs.desktop",
          "/usr/share/icons/hicolor/256x256/apps/sheets-docs.png": "icons/docs/docs-256.png",
          "/usr/share/icons/hicolor/128x128/apps/sheets-docs.png": "icons/docs/docs-128.png",
          "/usr/share/icons/hicolor/64x64/apps/sheets-docs.png": "icons/docs/docs-64.png"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBODM0MjRBMUMwMEI3M0EKUldRNnR3QWNTa0tES3RHU1ZpSzluOHJmbVdXVWJtZUEzcWRJNDB3ZjAveTlkSDNZSWk2dVZLMFgK",
      "endpoints": [
        "https://github.com/Dipendra-creator/sheets-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
